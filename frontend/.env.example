# Base URL of the Django API.
# Leave as /api to use the Vite dev proxy, or point at a deployed backend.
VITE_API_URL=/api

# Live chat (Tawk.to) on the applicant and agent dashboards and the Support
# page. Gabstep's own widget is built in (see src/lib/liveChat.js); set these
# only to point at a different one, from Tawk.to > Administration > Chat widget.
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# PostHog product analytics.
# Get your key from: PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
