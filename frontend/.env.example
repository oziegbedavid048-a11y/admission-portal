# Base URL of the Django API.
# Leave as /api to use the Vite dev proxy, or point at a deployed backend.
VITE_API_URL=/api

# Live chat on the Support page (Tawk.to). Both values are on the Tawk.to
# dashboard under Administration > Chat widget. Leave empty and the Support page
# says live chat is not available instead of showing a button that does nothing.
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default
