# Where the built app looks for the API: the site's own /api, which Vercel
# forwards to the Django backend on Render (see vercel.json).
#
# Same-origin on purpose. With the API on another domain, the sign-in cookie was
# a third-party cookie, and browsers that block those (Safari, and Chrome on
# many phones) dropped it, so every reload signed people out. Served from
# apply.gabstep.com/api the cookie is first-party and the session survives
# reloads.
#
# A dashboard variable of the same name still wins over this file, so clear it
# there if it is set.
VITE_API_URL=/api

# PostHog product analytics.
# VITE_POSTHOG_KEY is intentionally NOT committed here – set it only in the
# Vercel dashboard (Settings → Environment Variables) so the real key stays out
# of the repository.  The host default is safe to commit.
VITE_POSTHOG_HOST=https://us.i.posthog.com
