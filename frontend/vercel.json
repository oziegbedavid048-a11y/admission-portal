{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gabstep-backend-orlf.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://gabstep-backend-orlf.onrender.com/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/"
    }
  ]
}
