# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database. Leave DATABASE_URL empty to use the bundled SQLite file.
# Leave empty for the bundled SQLite file, or set a full URL:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# Access / refresh token lifetimes, in minutes and days
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Email / SMTP Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.gabstep.com
EMAIL_PORT=465
EMAIL_HOST_USER=support@gabstep.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Gabstep <support@gabstep.com>

# Where every link in every email points. The value below is for local work
# only. On a deployment set it to the site's own public address:
#
#   FRONTEND_URL=https://gabstep.com
#
# Django refuses to start with DJANGO_DEBUG=False and a localhost value here,
# because the mail would still send and the recipient would get a button that
# only works on the machine that sent it. See apps/accounts/checks.py.
FRONTEND_URL=http://localhost:5173

# ── Payments ──────────────────────────────────────────────────────
# With a Paystack secret key set, the applicant pays online and the provider
# posts to /api/payments/webhook/paystack/, which is the only thing that can
# settle a payment without a human. Leave both blank to run in transfer mode:
# the fee is recorded as outstanding and the desk confirms the transfer in the
# admin. Nothing else, anywhere, can mark a payment paid.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# The account an applicant transfers the fee to in transfer mode. All three are
# needed or none are shown: a half-filled instruction is worse than none.
PAYOUT_BANK_NAME=
PAYOUT_BANK_ACCOUNT=
PAYOUT_BANK_BENEFICIARY=

# ── Rate limits ───────────────────────────────────────────────────
# Requests per window, per client. The defaults are in settings.py; raise them
# only if a real person is hitting one.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_LOGIN=8/min
THROTTLE_REGISTER=5/hour
THROTTLE_EMAIL_CHECK=20/hour
THROTTLE_MONEY=12/hour
THROTTLE_UPLOAD=60/hour

# ── Admin bootstrap ───────────────────────────────────────────────
# Read by `manage.py ensure_admin`. There is no default password: supply one
# here or let the command generate and print one once.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=Admissions Desk
