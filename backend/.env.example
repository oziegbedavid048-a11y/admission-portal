# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database. Leave DATABASE_URL empty to use the bundled SQLite file.
# Leave empty for the bundled SQLite file, or set a full URL:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# Access / refresh token lifetimes, in minutes and days
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Email / SMTP Settings
# Leave EMAIL_BACKEND unset. It is chosen automatically: the provider's HTTPS API
# when EMAIL_PROVIDER_API_KEY is set, SMTP when only EMAIL_HOST_PASSWORD is, and
# the console when neither. Pinning it here overrides that, which is how a host
# that blocks SMTP keeps using SMTP however the rest is configured.
# EMAIL_BACKEND=

# Send over HTTPS instead of SMTP. Needed on a host that blocks outbound SMTP:
# the symptom is "Email failed: ... timed out" with correct credentials.
# EMAIL_PROVIDER is "zeptomail", "resend" or "brevo".
#
# For ZeptoMail the key is the value the console shows. Its own prefix,
# "Zoho-enczapikey", may be included or left off; either is accepted.
EMAIL_PROVIDER=zeptomail
# ZeptoMail REST host for the account's region.
ZEPTOMAIL_HOST=cpaas.zoho.com
# The Mail Agent alias from the same console page. Informational: the API key
# already belongs to one Mail Agent, so sending does not need it.
ZEPTOMAIL_AGENT_ALIAS=
EMAIL_PROVIDER_API_KEY=
EMAIL_HOST=mail.gabstep.com
EMAIL_PORT=465
EMAIL_HOST_USER=support@gabstep.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Gabstep <support@gabstep.com>

# Where every link in every email points. The value below is for local work
# only. On a deployment set it to the site's own public address:
#
#   FRONTEND_URL=https://apply.gabstep.com
#
# Django refuses to start with DJANGO_DEBUG=False and a localhost value here,
# because the mail would still send and the recipient would get a button that
# only works on the machine that sent it. See apps/accounts/checks.py.
FRONTEND_URL=http://localhost:5173


# ── Where the site and the API live ───────────────────────────────
# Same-origin is the shape to aim for: put the API under /api on the same host
# as the site, and leave this at Lax.
#
# If the frontend is on one host and the API on another (Vercel + Render, say),
# set this to None. The browser will not send a Lax cookie across hosts, so the
# session would be lost on every reload. Setting None also turns on
# CORS_ALLOW_CREDENTIALS, and the cookie is then forced Secure.
#
#   REFRESH_COOKIE_SAMESITE=None
REFRESH_COOKIE_SAMESITE=Lax

# ── Payments ──────────────────────────────────────────────────────
# With a Paystack secret key set, the applicant pays online and the provider
# posts to /api/payments/webhook/paystack/, which is the only thing that can
# settle a payment without a human. Leave both blank to run in transfer mode:
# the fee is recorded as outstanding and the desk confirms the transfer in the
# admin. Nothing else, anywhere, can mark a payment paid.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack's own charge, from paystack.com/pricing. The applicant is shown this
# on top of the fee and the card is debited the sum, so the figure on screen is
# the figure on the statement. Change these only if you have a negotiated rate.
PAYSTACK_FEE_PERCENT=1.5
PAYSTACK_FEE_FLAT_NGN=100
PAYSTACK_FEE_FLAT_WAIVED_UNDER_NGN=2500
PAYSTACK_FEE_CAP_NGN=2000

# Optional allowlist of addresses allowed to post webhooks, checked before the
# signature as defence in depth. Leave EMPTY on a managed host such as Render,
# which does not pass the original address through: the signature is what
# authenticates a webhook, not the address.
#   PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_WEBHOOK_IPS=


# The account an applicant transfers the fee to in transfer mode. All three are
# needed or none are shown: a half-filled instruction is worse than none.
PAYOUT_BANK_NAME=
PAYOUT_BANK_ACCOUNT=
PAYOUT_BANK_BENEFICIARY=

# ── Rate limits ───────────────────────────────────────────────────
# Requests per window, per client. The defaults are in settings.py; raise them
# only if a real person is hitting one.
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_LOGIN=8/min
THROTTLE_REGISTER=5/hour
THROTTLE_EMAIL_CHECK=20/hour
THROTTLE_MONEY=12/hour
THROTTLE_UPLOAD=60/hour

# ── Admin bootstrap ───────────────────────────────────────────────
# Read by `manage.py ensure_admin`. There is no default password: supply one
# here or let the command generate and print one once.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=Admissions Desk

# ── Uploaded files ────────────────────────────────────────────────
# By default uploads are saved on this server's disk, under MEDIA_ROOT. On Render
# that disk is wiped on every deploy unless a persistent disk is mounted there,
# which is how uploaded passports and letters used to disappear.
#
# Either mount a Render Disk and point MEDIA_ROOT at it:
#   MEDIA_ROOT=/opt/render/project/src/backend/media
#
# or store uploads in an S3-compatible bucket (Cloudflare R2, Amazon S3,
# Backblaze B2). The bucket stays private; links are signed and expire.
#   S3_BUCKET=gabstep-uploads
#   S3_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=
#   S3_REGION=auto
#   S3_URL_EXPIRE_SECONDS=3600
MEDIA_ROOT=
S3_BUCKET=

# ── Support ───────────────────────────────────────────────────────
# Messages sent from the Support page in any portal arrive here, with the
# sender as reply-to.
SUPPORT_EMAIL=support@gabstep.com
THROTTLE_SUPPORT=10/hour
